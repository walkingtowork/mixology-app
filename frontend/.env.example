# API Configuration
#
# Leave this unset. The app calls /api on its own origin, and the Vite dev proxy
# (vite.config.ts) forwards that to Django on http://localhost:8000 -- the same shape as
# production, where vercel.json rewrites /api to Railway. No .env file is needed.
#
# Set it only to bypass the proxy and call a backend directly. That makes the app
# cross-origin, so the session cookie is no longer first-party.
# VITE_API_BASE_URL=http://localhost:8000
