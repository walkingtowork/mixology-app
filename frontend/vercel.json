{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://mixology-app-production.up.railway.app/api/$1" },
    { "source": "/admin", "destination": "https://mixology-app-production.up.railway.app/admin/" },
    { "source": "/admin/(.*)", "destination": "https://mixology-app-production.up.railway.app/admin/$1" },
    { "source": "/static/(.*)", "destination": "https://mixology-app-production.up.railway.app/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
