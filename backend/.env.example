# Backend environment variables.
# Copy to backend/.env for local development. That file is gitignored.
#
# Local development needs DEBUG=True. With DEBUG=False and no SECRET_KEY the app now
# refuses to start, and the production-only security settings (secure cookies, HSTS)
# would be applied to a plain-http localhost.

DEBUG=True

# Required whenever DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-for-local-development

# Comma-separated. Defaults to localhost,127.0.0.1
# ALLOWED_HOSTS=.railway.app

# Comma-separated extra CORS origins, appended to the localhost defaults in settings.py.
# Must list the exact frontend origin, scheme included — renaming the Vercel domain
# without updating this breaks every API call.
# CORS_ALLOWED_ORIGINS=https://thebarcart.vercel.app,https://mixology-app-eight.vercel.app

# Set to True in production only. Left off locally and in CI, where requests are plain
# http and an unconditional redirect would turn every request into a 301.
# SECURE_SSL_REDIRECT=True

# Postgres connection string. Unset locally, where dj_database_url falls back to SQLite.
# DATABASE_URL=postgresql://...
